# Copy to .env before running docker compose
JWT_SECRET=change-me-to-a-long-random-string

# Port the app is reachable on (HTTP)
APP_PORT=8080
APP_TLS_PORT=8443

# For automatic HTTPS via Let's Encrypt: set your domain and use ports 80/443,
# e.g. SITE_ADDRESS=invite.example.com APP_PORT=80 APP_TLS_PORT=443
# Leave as :80 for plain HTTP.
SITE_ADDRESS=:80

# Set to true when serving over HTTPS
COOKIE_SECURE=false
